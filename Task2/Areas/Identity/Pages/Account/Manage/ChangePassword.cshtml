@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="identity-page">

    <div class="identity-card profile-identity-card">

        <div class="identity-left-panel">
            <span class="page-badge">Device Hub</span>

            <h1 class="identity-title">Security</h1>

            <p class="identity-subtitle">
                Update your password to keep your Device Hub account secure.
            </p>

            <div class="identity-feature-list">
                <div class="identity-feature-item">
                    <i class="fa-solid fa-lock"></i>
                    <span>Change your current password</span>
                </div>

                <div class="identity-feature-item">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>Passwords are hashed server-side</span>
                </div>

                <div class="identity-feature-item">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Protect access to management pages</span>
                </div>
            </div>
        </div>

        <div class="identity-form-panel">

            <div class="identity-form-header">
                <div class="identity-form-icon">
                    <i class="fa-solid fa-key"></i>
                </div>

                <h2>Change Password</h2>

                <p>
                    Enter your current password and choose a new one.
                </p>
            </div>

            <partial name="_StatusMessage" for="StatusMessage" />

            <form id="change-password-form"
                  method="post"
                  class="identity-form">

                <div asp-validation-summary="ModelOnly"
                     class="identity-validation-summary"
                     role="alert">
                </div>

                <div class="identity-form-group">
                    <label asp-for="Input.OldPassword">Current Password</label>

                    <div class="identity-input-wrapper">
                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="Input.OldPassword"
                               class="identity-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Enter your current password" />
                    </div>

                    <span asp-validation-for="Input.OldPassword"
                          class="identity-validation">
                    </span>
                </div>

                <div class="identity-form-group">
                    <label asp-for="Input.NewPassword">New Password</label>

                    <div class="identity-input-wrapper">
                        <i class="fa-solid fa-key"></i>

                        <input asp-for="Input.NewPassword"
                               class="identity-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Enter your new password" />
                    </div>

                    <span asp-validation-for="Input.NewPassword"
                          class="identity-validation">
                    </span>
                </div>

                <div class="identity-form-group">
                    <label asp-for="Input.ConfirmPassword">Confirm New Password</label>

                    <div class="identity-input-wrapper">
                        <i class="fa-solid fa-check"></i>

                        <input asp-for="Input.ConfirmPassword"
                               class="identity-input"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="Confirm your new password" />
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="identity-validation">
                    </span>
                </div>

                <button type="submit"
                        class="identity-submit-btn">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Update Password
                </button>

                <div class="identity-bottom-links">
                    <p>
                        Want to update profile details?
                        <a asp-page="./Index">
                            Back to profile
                        </a>
                    </p>
                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}