@page
@model ResetPasswordModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="simple-auth-page">

    <div class="simple-auth-card">

        <div class="simple-auth-header">
            <div class="simple-auth-icon">
                <i class="fa-solid fa-lock-open"></i>
            </div>

            <h1>New Password</h1>
            <p>Create a new password for your account</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="identity-validation-summary"
                 role="alert">
            </div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="simple-auth-group">
                <label asp-for="Input.Email">Email</label>

                <div class="simple-auth-input">
                    <i class="fa-solid fa-envelope"></i>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>

                <span asp-validation-for="Input.Email" class="identity-validation"></span>
            </div>

            <div class="simple-auth-group">
                <label asp-for="Input.Password">New Password</label>

                <div class="simple-auth-input">
                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Input.Password"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="New password" />
                </div>

                <span asp-validation-for="Input.Password" class="identity-validation"></span>
            </div>

            <div class="simple-auth-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>

                <div class="simple-auth-input">
                    <i class="fa-solid fa-check"></i>

                    <input asp-for="Input.ConfirmPassword"
                           autocomplete="new-password"
                           aria-required="true"
                           placeholder="Confirm password" />
                </div>

                <span asp-validation-for="Input.ConfirmPassword" class="identity-validation"></span>
            </div>

            <button type="submit" class="simple-auth-btn">
                Reset Password
            </button>

            <div class="simple-auth-footer">
                <span>Already fixed?</span>
                <a asp-page="./Login">
                    Back to login
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}