@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="simple-auth-page">

    <div class="simple-auth-card">

        <div class="simple-auth-header">
            <div class="simple-auth-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <h1>Reset Password</h1>
            <p>Enter your email to continue</p>
        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="identity-validation-summary"
                 role="alert">
            </div>

            <div class="simple-auth-group">
                <label asp-for="Input.Email">Email</label>

                <div class="simple-auth-input">
                    <i class="fa-solid fa-envelope"></i>

                    <input asp-for="Input.Email"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                </div>

                <span asp-validation-for="Input.Email" class="identity-validation"></span>
            </div>

            <button type="submit" class="simple-auth-btn">
                Reset Password
            </button>

            <div class="simple-auth-footer">
                <span>Remembered it?</span>
                <a asp-page="./Login">
                    Back to login
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}