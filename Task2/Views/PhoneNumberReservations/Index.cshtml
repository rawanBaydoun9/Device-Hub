<div ng-app="devicesApp" ng-controller="PhoneNumberReservationsPageController" class="devices-page">

    <!-- Toast Notification -->
    <div class="toast-container-custom" ng-if="toast.show">
        <div class="app-toast" ng-class="'toast-' + toast.type">
            <div class="toast-icon">
                <i class="fa-solid"
                   ng-class="{
                    'fa-circle-check': toast.type === 'success',
                    'fa-circle-xmark': toast.type === 'error',
                    'fa-circle-info': toast.type === 'info'
               }">
                </i>
            </div>

            <div class="toast-content">
                <strong>{{ toast.title }}</strong>
                <span>{{ toast.message }}</span>
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div class="loading-overlay" ng-show="isLoading">
        <div class="loading-card">
            <div class="loading-spinner"></div>
            <p>{{ loadingMessage }}</p>
        </div>
    </div>

    <div class="container">
        <div class="devices-card">

            <div class="page-header-modern">
                <span class="page-badge">Reservation Manager</span>
                <h1 class="page-title">Reservations</h1>
                <p class="page-subtitle">
                    View, filter, and export phone number reservation reports.
                </p>
            </div>

            <!-- Filters + Export only, no Add/Edit/Delete -->
            <!-- Filters + Export only, no Add/Edit/Delete -->
            <div class="filter-search-area reservation-filter-area">

                <div class="filter-row reservation-filter-row">

                    <!-- Client Filter -->
                    <div class="filter-box reservation-filter-box">
                        <i class="fa-solid fa-user filter-icon"></i>

                        <client-selector selected-value="clientFilter"
                                         clients="clients"
                                         include-all="true"
                                         css-class="stock-filter"
                                         placeholder="All Clients"
                                         on-changed="loadReservations()">
                        </client-selector>
                    </div>

                    <!-- Phone Number Filter -->
                    <div class="filter-box reservation-filter-box">
                        <i class="fa-solid fa-phone filter-icon"></i>

                        <phone-number-selector selected-value="phoneNumberFilter"
                                               phone-numbers="phoneNumbers"
                                               include-all="true"
                                               css-class="stock-filter"
                                               placeholder="All Phone Numbers"
                                               on-changed="loadReservations()">
                        </phone-number-selector>
                    </div>

                    <!-- Status Filter -->
                    <div class="filter-box reservation-filter-box">
                        <i class="fa-solid fa-circle-check filter-icon"></i>

                        <select class="stock-filter"
                                ng-model="statusFilter"
                                ng-change="loadReservations()">
                            <option value="">All Status</option>
                            <option value="active">Active</option>
                            <option value="ended">Ended</option>
                        </select>
                    </div>

                    <!-- Export Word Button -->
                    <button type="button"
                            class="export-report-btn reservation-export-btn"
                            ng-click="openReportModal()"
                            title="Generate Report">
                        <span class="export-icon">
                            <i class="fa-solid fa-file-export"></i>
                        </span>

                        <span class="export-text">
                            Generate Report
                        </span>
                    </button>

                </div>

            </div>

            <div class="print-report-header">
                <h2>Phone Number Reservations Report</h2>
                <p>
                    Generated report based on the selected filters.
                </p>
            </div>

            <!-- Reservations Table -->
            <div class="table-responsive">
                <table class="table devices-table">
                    <thead>
                        <tr>
                            <th class="id-col">ID</th>
                            <th>Client</th>
                            <th>Phone Number</th>
                            <th>BED</th>
                            <th>EED</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr ng-repeat="reservation in reservations">
                            <td>{{ reservation.id }}</td>

                            <td class="device-name">
                                <i class="fa-solid fa-user reservation-inline-icon"></i>
                                {{ reservation.clientName }}
                            </td>

                            <td>
                                <span class="category-badge">
                                    {{ reservation.phoneNumberValue }}
                                </span>
                            </td>

                            <td>
                                {{ reservation.bedText }}
                            </td>

                            <td>
                                <span class="category-badge"
                                      ng-class="{ 'active-reservation-badge': reservation.eedText === 'Active' }">
                                    {{ reservation.eedText }}
                                </span>
                            </td>
                        </tr>

                        <tr ng-if="reservations.length === 0">
                            <td colspan="5" class="empty-state">
                                No reservations found.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Generate Report Modal -->
    <script type="text/ng-template" id="generateReportModal.html">
        <div class="modal-header custom-modal-header">
            <h3 class="modal-title">Generate Reservation Report</h3>
            <p class="modal-subtitle">
                Choose the report format you want to export.
            </p>
        </div>

        <div class="modal-body custom-modal-body">

            <div class="report-format-grid">

                <button type="button"
                        class="report-format-card"
                        ng-click="chooseFormat('word')">
                    <div class="report-format-icon word-format">
                        <i class="fa-solid fa-file-word"></i>
                    </div>

                    <div>
                        <h4>Word Document</h4>
                        <p>Download the report as a Word file.</p>
                    </div>
                </button>

                <button type="button"
                        class="report-format-card"
                        ng-click="chooseFormat('pdf')">
                    <div class="report-format-icon pdf-format">
                        <i class="fa-solid fa-file-pdf"></i>
                    </div>

                    <div>
                        <h4>PDF Document</h4>
                        <p>Open print preview and save as PDF.</p>
                    </div>
                </button>

            </div>

        </div>

        <div class="modal-footer custom-modal-footer">
            <button type="button"
                    class="btn modal-cancel-btn"
                    ng-click="cancel()">
                <i class="fa-solid fa-xmark"></i> Cancel
            </button>
        </div>
    </script>

</div>